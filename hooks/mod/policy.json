{
  "_comment": "What the neuroflow mod may do. CI compares `claude plugin validate --json` with this file (scripts/automation/mod_policy.py); change it only with a reviewed change to the mod.",
  "events": [
    "command.describe",
    "command.run",
    "prompt.compose",
    "prompt.submit",
    "session.start",
    "tool.call",
    "turn.complete",
    "ui.render"
  ],
  "calls": [
    "$.clock.after",
    "$.clock.now",
    "$.command.run",
    "$.env.get",
    "$.fs.exists",
    "$.fs.list",
    "$.fs.read",
    "$.fs.stat",
    "$.fs.write",
    "$.model.complete",
    "$.process.run",
    "$.prompt.fill",
    "$.prompt.submit",
    "$.prompt.suggest",
    "$.session.append",
    "$.session.cwd",
    "$.session.model",
    "$.session.surfaces",
    "$.session.usage",
    "$.session.version",
    "$.state.get",
    "$.state.set",
    "$.store.get",
    "$.store.set",
    "$.ui.ask",
    "$.ui.close",
    "$.ui.invalidate",
    "$.ui.log",
    "$.ui.notice",
    "$.ui.open",
    "$.ui.resolve",
    "$.ui.status",
    "$.ui.toast"
  ],
  "envReads": [
    "HOME",
    "PBS_JOBID",
    "SLURM_JOB_ID",
    "USERPROFILE"
  ],
  "envWrites": [],
  "stateWrites": [
    "neuroflow.activeCommand",
    "neuroflow.bandHidden",
    "neuroflow.boardLevel",
    "neuroflow.boardPick",
    "neuroflow.capture",
    "neuroflow.citeQueue",
    "neuroflow.dashboardTab",
    "neuroflow.draftedDecision",
    "neuroflow.drive",
    "neuroflow.flowieSync",
    "neuroflow.gitAlias",
    "neuroflow.loginNode",
    "neuroflow.loopView",
    "neuroflow.memoryStructure",
    "neuroflow.paperView",
    "neuroflow.pickerNote",
    "neuroflow.profileDigest",
    "neuroflow.quietSince",
    "neuroflow.reasoningBaseline",
    "neuroflow.scope",
    "neuroflow.snapshot",
    "neuroflow.statusAlerts",
    "neuroflow.taskView",
    "neuroflow.turnWrites",
    "neuroflow.wikiCards",
    "neuroflow.wikiIndex",
    "neuroflow.wikiPick",
    "neuroflow.xrayPick",
    "neuroflow.xrayView"
  ]
}
